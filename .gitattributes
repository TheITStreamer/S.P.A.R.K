# Let git decide what is text and normalise it to LF in the repository, while
# checking it out with whatever the platform wants. Without this, a file saved
# by one editor with CRLF and another with LF shows up as EVERY LINE CHANGED,
# which made real diffs unreadable — several files were showing as fully
# rewritten when only a couple of lines had actually moved.
* text=auto

# Belt and braces for the extensions that were actually causing it.
*.js    text
*.json  text
*.html  text
*.css   text
*.md    text
*.rs    text
*.toml  text
*.txt   text

# Binary. Marking these explicitly stops git ever trying to "fix" line endings
# inside them, which corrupts the file.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.mp3   binary
*.wav   binary
*.ogg   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
